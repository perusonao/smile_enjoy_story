{
  "name": "ses-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright E2E harness for S.E.S. - Smile. Enjoy. Story. (Flutter Web). Real-UI QA/UX audit layer, independent from the Dart headless simulations under /tool.",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=mobile-chromium",
    "test:webkit": "playwright test --project=mobile-webkit",
    "report": "playwright show-report",
    "seeds:10": "cross-env SES_E2E_SEEDS=100001,100002,100003,100004,100005,100006,100007,100008,100009,100010 playwright test tests/founding-first-assignment.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.0"
  }
}
