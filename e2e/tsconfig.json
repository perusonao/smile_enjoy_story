{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["helpers/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "playwright.config.ts", "tests-showcase/**/*.ts", "playwright.showcase.config.ts"]
}
